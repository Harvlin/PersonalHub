POSTGRES_DB=personal_hub
POSTGRES_USER=personal_hub
POSTGRES_PASSWORD=replace-with-a-long-random-password
PERSONAL_HUB_USERNAME=personal
# Generate with: docker run --rm -it eclipse-temurin:21-jdk jshell
# Use a BCrypt hash generated by the backend tooling or an external BCrypt generator.
PERSONAL_HUB_PASSWORD_HASH=replace-with-a-bcrypt-password-hash
APP_CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
